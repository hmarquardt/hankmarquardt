{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deepcuts",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "deepcuts.hankmarquardt.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ORIGIN": "https://deepcuts.hankmarquardt.com",
    "DEPLOY_REVISION": "unreleased"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deepcuts",
      "database_id": "REPLACE_PRODUCTION_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MUSIC", "bucket_name": "deepcuts-originals" }],
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "72103",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
