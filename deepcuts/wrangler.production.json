{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deepcuts",
  "account_id": "b1aa310aa0a1638d72b8b086a21e557c",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "deepcuts.hankmarquardt.com",
      "zone_id": "1d02b937540d58cb201c4abcbb7df4d1",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ORIGIN": "https://deepcuts.hankmarquardt.com",
    "DEPLOY_REVISION": "unreleased"
  },
  "secrets": { "required": ["OWNER_KEY"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deepcuts",
      "database_id": "0922ad5d-3193-4e49-9ff5-9926d782792d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MUSIC", "bucket_name": "deepcuts-originals" }],
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "72103",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
